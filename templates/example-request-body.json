      "username": "your-dockerhub-username",
      "password": "your-dockerhub-password",
      "repositoryName": "your-dockerhub-username/my-api"
    },
    "configMap": {
      "PORT": "3000",
      "LOG_LEVEL": "info"
    },
    "volumeName": null
  }
