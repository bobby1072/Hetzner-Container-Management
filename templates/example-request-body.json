[
  {
    "containerName": "my-web-app",
    "externalPortNumber": 8080,
    "internalPortNumber": 80,
    "imageTag": "latest",
    "dockerHubDetails": {
      "username": "your-dockerhub-username",
      "password": "your-dockerhub-password",
      "repositoryName": "your-dockerhub-username/my-web-app"
    },
    "configMap": {
