{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ASPNETCORE_ENVIRONMENT": "Development",
  "AllowedHosts": "*",
  "RequestTimeout": 60,
  "ApiKey": [
    "<USE-SECRETS>"
  ],
  "InfrastructureJsonPath": "",
  "ServiceInfo": {
    "ReleaseName": "Hetzner.Container.Management.Api",
    "ReleaseVersion": "1.0"
  },
  "DockerEngineApiSettings": {
    "UnixDomainSocketEndPoint": "/var/run/docker.sock",
    "TestUnixHttpEndPoint": "http://localhost:2375",
    "UseTestHttpEndPoint": true,
    "TimeoutInSeconds": 30,
    "TotalAttempts": 2,
    "DelayBetweenAttemptsInSeconds": 1,
    "ApiVersion": "v1.52"
  },
  "DockerHubApiSettings": {
    "BaseUrl": "https://hub.docker.com",
    "RegistryUri": "registry-1.docker.io",
    "TimeoutInSeconds": 30,
    "TotalAttempts": 2,
    "DelayBetweenAttemptsInSeconds": 1
  }
}