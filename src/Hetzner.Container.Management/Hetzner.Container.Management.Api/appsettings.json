{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RequestTimeout": 60,
  "ApiKey": ["<USE-SECRETS>"],
  "ServiceInfo": {
    "ReleaseName": "Hetzner.Container.Management.Api",
    "ReleaseVersion": "1.0"
  },
  "DockerEngineApiSettings": {
    "UnixDomainSocketEndPoint":  "http://localhost:2375",
    "TimeoutInSeconds": 30,
    "TotalAttempts": 2,
    "DelayBetweenAttemptsInSeconds":  1
  },
  "DockerHubApiSettings": {
    "BaseUrl":  "https://registry.hub.docker.com",
    "RegistryUri": "registry-1.docker.io",
    "TimeoutInSeconds": 30,
    "TotalAttempts": 2,
    "DelayBetweenAttemptsInSeconds":  1
  }
}
